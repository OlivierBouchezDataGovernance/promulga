# ---------------------------------------------------------------------------
# Promulga configuration. Created as ".env" by deploy/setup.sh (mode 600).
# Never commit ".env". Passwords and tokens do NOT go here: each one is a file
# in secrets/ (see deploy/setup.sh), mounted read-only in the container.
# Everything visual (colours, logo, banner, footer, deadlines, alerts) is set
# in the web interface (Admin > Settings), not here.
# ---------------------------------------------------------------------------

# Host name(s) served by Caddy with automatic HTTPS. ":80" = plain HTTP (tests only).
SITE_DOMAIN=docs.example.org
# Public address of the site, used in e-mail links (no trailing slash).
BASE_URL=https://docs.example.org
# Mark cookies "secure" (HTTPS only). Set to false only for plain-HTTP tests.
SECURE_COOKIES=true
# Time zone of deadlines and reminders.
TZ=Europe/Brussels
# Ports published by Caddy (change HTTP_PORT if 80 is taken on a test machine).
HTTP_PORT=80
HTTPS_PORT=443

# First administrator, created at the first start if no administrator exists.
# Leave ADMIN_PASSWORD empty (recommended): a one-time link to choose the password
# is printed in the logs:  docker compose logs app | grep set-password
# If you set it, it must be changed at the first sign-in; remove it afterwards.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Identifiers and file names. Tags: {ID} {REF} {TITLE} {TYPE} {TYPE_CODE} {DOMAIN}
# {CODE:<taxonomy>} {TAG:<taxonomy>} {VERSION} {SUBVERSION} {FULL_VERSION} {STATUS}
# {AUTHOR} {DATE}. {ID} is the global document number (0001, ... 10000).
# ---------------------------------------------------------------------------
REF_PATTERN={TYPE_CODE}-{ID}
FILENAME_PATTERN={REF}-v{VERSION}.{SUBVERSION}-{TITLE}
# Example with the domain code of the tag:  {CODE:domain}-{TYPE_CODE}-{VERSION}-{SUBVERSION}-{TITLE}

# ---------------------------------------------------------------------------
# E-mail (optional). Without SMTP, e-mails stay in Admin > Outbox (fine for demos).
# The password goes in secrets/smtp_password. Google Cloud blocks port 25: use 587 or 465.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=Governance documents <no-reply@example.org>
SMTP_STARTTLS=true
SMTP_SSL=false

# ---------------------------------------------------------------------------
# Public export (Admin > Export): documents tagged EXPORT_TAG, pushed to GitHub.
# The token (fine-grained, "Contents: read and write" on this repository only)
# goes in secrets/github_token.
# ---------------------------------------------------------------------------
EXPORT_TAG=public
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_FOLDER=policies
# Address where the exported folder is published (absolute links in the catalogue).
EXPORT_SITE_URL=

# ---------------------------------------------------------------------------
# Electronic seal: sign every published PDF (PAdES). Without SIGNING_CERT_FILE a
# self-signed certificate is created in the data volume (readers see "signer
# unknown" until they trust it); with your organisation's .p12, put its password
# in secrets/signing_cert_password and mount the file.
# ---------------------------------------------------------------------------
SIGN_PDFS=false
SIGNING_CERT_FILE=

# ---------------------------------------------------------------------------
# Online editor (OnlyOffice): start with  docker compose --profile editor up -d
# and set ONLYOFFICE_URL=/onlyoffice. The shared secret is generated by setup.sh.
# ---------------------------------------------------------------------------
ONLYOFFICE_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Two separate sites: portal on PUBLIC_HOST, admin on ADMIN_HOST (list both in SITE_DOMAIN).
PUBLIC_HOST=
ADMIN_HOST=
# Intranet-only portal: comma-separated networks allowed to read the portal.
PORTAL_ALLOWED_IPS=
# Single sign-on (OpenID Connect). The client secret goes in secrets/oidc_client_secret.
# Redirect URI to register at the provider: BASE_URL + /auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_LABEL=Sign in with my organisation account
OIDC_AUTO_CREATE_ROLE=
# PostgreSQL instead of the built-in SQLite file (optional).
# DATABASE_URL=postgresql+psycopg://promulga:password@db:5432/promulga
MAX_UPLOAD_MB=25
