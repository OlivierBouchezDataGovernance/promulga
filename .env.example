# ---------------------------------------------------------------------------
# Promulga configuration. Copy to ".env" and edit. Never commit ".env".
# Everything visual (colours, logo, banner, footer, deadlines, alerts) is set
# in the web interface (Admin > Settings), not here.
# ---------------------------------------------------------------------------

# Host name(s) served by Caddy with automatic HTTPS. ":80" = plain HTTP (tests only).
SITE_DOMAIN=docs.example.org
# Public address of the site, used in e-mail links (no trailing slash).
BASE_URL=https://docs.example.org
# Mark cookies "secure" (HTTPS only). Set to false only for plain-HTTP tests.
SECURE_COOKIES=true
# Time zone of deadlines and reminders.
TZ=Europe/Brussels

# Long random secret that signs the session cookies. Generate one with:
#   openssl rand -base64 48
# If empty, a random key is created in the data volume at first start.
SECRET_KEY=

# First administrator, created at first start if no administrator exists.
# You can remove the password from this file after your first sign-in.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# E-mail (optional). Without SMTP, e-mails stay in Admin > Outbox (fine for demos).
# Any SMTP service works: your organisation's server, Brevo, Mailjet, SendGrid...
# Google Cloud blocks port 25: use 587 (STARTTLS) or 465 (SMTP_SSL=true).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Governance documents <no-reply@example.org>
SMTP_STARTTLS=true
SMTP_SSL=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Two separate sites: portal on PUBLIC_HOST, admin on ADMIN_HOST (list both in SITE_DOMAIN).
PUBLIC_HOST=
ADMIN_HOST=
# Intranet-only portal: comma-separated networks allowed to read the portal.
# Example: 10.0.0.0/8,192.168.0.0/16  (the admin site is not affected)
PORTAL_ALLOWED_IPS=

# Single sign-on with any OpenID Connect provider (Entra ID, Google, Keycloak, Authentik...).
# Redirect URI to register at the provider: BASE_URL + /auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Sign in with my organisation account
# Role given to unknown people signing in with SSO ("" = only invited people may sign in).
OIDC_AUTO_CREATE_ROLE=

# PostgreSQL instead of the built-in SQLite file (optional, for large installations).
# DATABASE_URL=postgresql+psycopg://promulga:password@db:5432/promulga

# Maximum size of an uploaded file, in MB.
MAX_UPLOAD_MB=25
