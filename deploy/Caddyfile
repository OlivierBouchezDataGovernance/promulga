# SITE_DOMAIN comes from .env. Examples:
#   SITE_DOMAIN=docs.example.org                      one host: portal at /, admin at /admin
#   SITE_DOMAIN=docs.example.org, admin.example.org   two hosts (also set PUBLIC_HOST and ADMIN_HOST)
#   SITE_DOMAIN=:80                                   plain HTTP, no certificate (local tests only)
{$SITE_DOMAIN} {
	encode gzip
	request_body {
		max_size 50MB
	}

	# Online editor (profile "editor"): OnlyOffice served under /onlyoffice.
	handle_path /onlyoffice/* {
		reverse_proxy onlyoffice:80 {
			header_up X-Forwarded-Host {host}/onlyoffice
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy app:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
